<!-- 
-- #desc: This is an export of an official Oracle SQL Developer report Invalid objects.
--        It shows how to add an extra item "Compile?" to the row popup menu.
-- #date: 2026-11-13
-->

<?xml version="1.0" encoding="UTF-8" ?>
<displays>
    <display id="a7d8a75e-0114-1000-8206-c0a8010a29c4" type="report" style="" enable="true">
        <name><![CDATA[Invalid Objects]]></name>
        <description><![CDATA[Lists all objects that have a status of invalid]]></description>
        <tooltip><![CDATA[Invalid Objects]]></tooltip>
        <drillclass><![CDATA[]]></drillclass>
        <CustomValues>
        </CustomValues>
        <query>
            <sql>
                <![CDATA[
                       select owner                "Owner",
                                       initcap(object_type) "Object_Type",
                                       object_name          "Object_Name",
                                       owner                 sdev_link_owner,
                                       object_name           sdev_link_name,
                                       object_type           sdev_link_type
                                  from sys.all_objects
                                 where status = 'INVALID'
                                   and substr(object_name,1,4) != 'BIN$'
                                   and substr(object_name,1,3) != 'DR$'
                                   and (:OWNER is null or
                                         upper(owner) LIKE upper(:OWNER))
                                 order by owner, object_type, object_name    
                    ]]>
            </sql>
            <binds>
                <bind id="OWNER">
                    <prompt><![CDATA[Owner]]></prompt>
                    <tooltip><![CDATA[Name or part of name to search for (case insensitive).]]></tooltip>
                    <value><![CDATA[NULL_VALUE]]></value>
                    <bracket><![CDATA[null]]></bracket>
                </bind>
            </binds>
        </query>
        <item  
            reload="true"  
            reloadparent="true" 
            removeFromParent="true" 
            toolbar="false" 
            >
            <title>Compile</title>
            <prompt type="confirm" required="false" >
                <label>Compile?</label>
                <default><![CDATA[]]></default>	
                <value><![CDATA[]]></value>   	
            </prompt>
            <sql>
                <![CDATA[
                    begin 
                        execute immediate 'alter '
                            ||  case when upper('#OBJECT_TYPE#')='PACKAGE BODY' then 'PACKAGE' 
                                else upper('#OBJECT_TYPE#') 
                                end 
                            ||  ' "'||upper('#OWNER#')||'"."'||upper('#OBJECT_NAME#')
                            ||  '" compile '
                            ||  case when upper('#OBJECT_TYPE#')='PACKAGE BODY' then 'BODY' 
                                else null 
                                end; 
                    end;
                    ]]>
            </sql>
            <script language="js">
                <![CDATA[]]>
            </script>
            <help>Compile this invalid object.</help>
        </item>
    </display>
</displays>