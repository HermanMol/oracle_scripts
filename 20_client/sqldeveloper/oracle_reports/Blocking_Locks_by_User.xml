<?xml version="1.0" encoding="UTF-8" ?>
<displays>
<display id="b3c3352b-011c-1000-800b-c0a8016a141d" type="" style="Table" enable="true" requiredLic="diagnostics">
	<name><![CDATA[Blocking Locks by User]]></name>
	<description><![CDATA[Blocking Locks by user (Except type MR)]]></description>
	<tooltip><![CDATA[Blocking Locks by user]]></tooltip>
	<drillclass><![CDATA[]]></drillclass>
	<CustomValues>
		<TYPE><![CDATA[null]]></TYPE>
	</CustomValues>
	<query>
		<sql><![CDATA[select /*+ ORDERED */
   blocker.sid blocker_sid
,  waiting.sid waiting_sid
,  TRUNC(waiting.ctime/60) min_waiting
,  waiting.request
from (select *
      from gv$lock
      where block != 0
      and type = 'TX') blocker
,    gv$lock            waiting
where waiting.type='TX' 
and waiting.block = 0
and waiting.id1 = blocker.id1]]></sql>
		<binds>
			<bind id="USER_NAME">
				<prompt><![CDATA[USER_NAME]]></prompt>
				<tooltip><![CDATA[USER_NAME]]></tooltip>
				<value><![CDATA[NULL_VALUE]]></value>
				<bracket><![CDATA[null]]></bracket>
			</bind>
		</binds>
	</query>
	<display id="" type="Child" style="Table" enable="true">
		<name><![CDATA[SQL from Blocking Session]]></name>
		<description><![CDATA[]]></description>
		<tooltip><![CDATA[]]></tooltip>
		<drillclass><![CDATA[]]></drillclass>
		<CustomValues>
		</CustomValues>
		<query>
			<sql><![CDATA[select  sql_text from gv$sql sql, gv$active_session_history seh 
where seh.sql_id = sql.sql_id
and session_id = :BLOCKER_SID
and session_type='FOREGROUND' and seh.sql_id is not null
]]></sql>
			<binds>
				<bind id="BLOCKER_SID">
					<prompt><![CDATA[BLOCKER_SID]]></prompt>
					<tooltip><![CDATA[BLOCKER_SID]]></tooltip>
					<value><![CDATA[NULL_VALUE]]></value>
					<bracket><![CDATA[null]]></bracket>
				</bind>
			</binds>
		</query>
	</display>
	<display id="" type="Child" style="Table" enable="true">
		<name><![CDATA[SQL from Waiting Session]]></name>
		<description><![CDATA[]]></description>
		<tooltip><![CDATA[]]></tooltip>
		<drillclass><![CDATA[]]></drillclass>
		<CustomValues>
		</CustomValues>
		<query>
			<sql><![CDATA[select sql_text from gv$sql where sql_id in ( select sql_id  from gv$session
  where  sid= :WAITING_SID)]]></sql>
			<binds>
				<bind id="WAITING_SID">
					<prompt><![CDATA[WAITING_SID]]></prompt>
					<tooltip><![CDATA[WAITING_SID]]></tooltip>
					<value><![CDATA[NULL_VALUE]]></value>
					<bracket><![CDATA[null]]></bracket>
				</bind>
			</binds>
		</query>
	</display>
</display>
</displays>